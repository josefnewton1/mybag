#:include kv/homepage.kv
#:include kv/ajustespage.kv
#:include kv/adicionarvendaspage.kv
#:include kv/adicionarvendedorpage.kv
#:include kv/listavendedorpage.kv
#:include kv/todasvendaspage.kv
#:include kv/fotoperfilpage.kv


FloatLayout:
    canvas:
        Color:
            rgb:(0.05, 0.45452,0.45,0.2)
        Rectangle:
            size: self.size
            pos: self.pos


    Image:
        pos_hint: {"right":1, "top": 0.9}
        size_hint: 1 , 0.2
        source: "icones/hash.png"
    ScreenManager:
        pos_hint:{"right":1, "top": 0.7}
        size_hint: 1 , 0.7
        id: screen_manager
        HomePage:
            name: "homepage"
            id: homepage
        AjustesPage:
            name: "ajustespage"
            id: ajustespage
        AdicionarVendasPage:
            name: "adicionarvendaspage"
            id: adicionarvendaspage
        AdicionarVendedorPage:
            name: "adicionarvendedorpage"
            id: adicionarvendedorpage
        FotoPerfilPage:
            name: "fotoperfilpage"
            id: fotoperfilpage
        ListaVendedorPage:
            name: "listavendedorpage"
            id: listavendedorespage
        TodasVendasPage:
            name: "todasvendaspage"
            id: todasvendaspage
